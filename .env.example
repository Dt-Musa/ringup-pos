# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos?schema=public"

# 32+ character random secret used to encrypt the session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"

# Demo password used by `npm run db:seed` for the 3 demo users
SEED_PASSWORD="Pos@12345"
